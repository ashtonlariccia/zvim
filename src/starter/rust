" Rust. Installed by zvim -s; change it as you like (zvim --help explains
" the format). Words go in groups; each group has a colour in zvimrc.
extensions rs

span comment //
span comment /* */
span string r#" "#
span string " " escape=\
prefix constant '
suffix function !
numbers
functions

keyword as async await break const continue crate dyn else enum extern fn for
keyword if impl in let loop match mod move mut pub ref return self Self static
keyword struct super trait type unsafe use where while macro_rules
type i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32 f64 bool char str
type String Vec Option Result Box Rc Arc
constant true false None Some Ok Err
todo TODO FIXME XXX NOTE
