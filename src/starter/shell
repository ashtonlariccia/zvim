" Shell scripts. Installed by zvim -s; change it as you like (zvim --help
" explains the format). Words go in groups; each group has a colour in zvimrc.
extensions sh bash zsh ksh
shebang sh bash zsh ksh dash

span comment # alone
span string " " escape=\
span string ' '
prefix constant $
numbers

keyword if then else elif fi case esac for while until do done in function
keyword return break continue local export readonly declare unset shift exit
keyword source alias set trap eval exec select time
function echo printf read cd pwd test true false command type kill wait
