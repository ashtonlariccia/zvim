" Python. Installed by zvim -s; change it as you like (zvim --help explains
" the format). Words go in groups; each group has a colour in zvimrc.
extensions py pyw pyi
shebang python python3 python2

span comment #
span string """ """ escape=\
span string ''' ''' escape=\
span string " " escape=\ oneline
span string ' ' escape=\ oneline
prefix function @
numbers
functions

keyword if elif else while for in break continue return pass def class lambda
keyword import from as try except finally raise with yield global nonlocal
keyword and or not is del assert async await match case
type int float complex str bytes bytearray bool list dict set frozenset tuple
type object type range
constant True False None self cls
todo TODO FIXME XXX NOTE
